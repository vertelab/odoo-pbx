{# Jinja2 template for Asterisk PJSIP config per tenant #}
; Auto-generated by pbx_admin — tenant: {{ tenant.domain }}
; DO NOT EDIT MANUALLY

[{{ tenant.domain }}-endpoint](!)
type = endpoint
context = {{ tenant.domain }}-internal
disallow = all
allow = ulaw,alaw,g722,opus
direct_media = no
rtp_symmetric = yes
force_rport = yes

[{{ tenant.domain }}-aor](!)
type = aor
max_contacts = 10
remove_existing = yes

[{{ tenant.domain }}-identify]
type = identify
match = {{ tenant.domain }}
endpoint = {{ tenant.domain }}-endpoint

; --- Auth template ---
[{{ tenant.domain }}-auth](!)
type = auth
auth_type = userpass

; --- Extensions ---
{% for ext in tenant.extensions %}
{% for sub in ext.get('sub', []) %}
{% if sub.type != 'voicemail' %}
[{{ tenant.domain }}-{{ sub.number }}]
type = endpoint
context = {{ tenant.domain }}-internal
auth = {{ tenant.domain }}-{{ sub.number }}-auth
aors = {{ tenant.domain }}-{{ sub.number }}
callerid = "{{ ext.name }}" <{{ ext.public }}@{{ tenant.domain }}>
transport = {{ sub.get('transport', 'udp') }}-transport

[{{ tenant.domain }}-{{ sub.number }}-auth]({{ tenant.domain }}-auth)
password = {{ sub.get('secret', '') }}
username = {{ sub.get('username', sub.number) }}

{% endif %}
{% endfor %}
{% endfor %}

; --- Trunks ---
{% for trunk in tenant.get('trunks', []) %}
[{{ tenant.domain }}-trunk-{{ trunk.name|lower|replace(' ', '-') }}]
type = endpoint
context = {{ tenant.domain }}-incoming
disallow = all
allow = ulaw,alaw
aors = {{ tenant.domain }}-trunk-{{ trunk.name|lower|replace(' ', '-') }}
outbound_auth = {{ tenant.domain }}-trunk-{{ trunk.name|lower|replace(' ', '-') }}-auth

[{{ tenant.domain }}-trunk-{{ trunk.name|lower|replace(' ', '-') }}-auth]
type = auth
auth_type = userpass
password = {{ trunk.secret }}
username = {{ trunk.username }}
{% endfor %}
