{# Jinja2 template for Asterisk extensions config per tenant #}
; Auto-generated by pbx_admin — tenant: {{ tenant.domain }}
; DO NOT EDIT MANUALLY

[{{ tenant.domain }}-internal]
switch = Realtime

; --- Ring Groups ---
{% for ext in tenant.extensions %}
{% set active_subs = ext.get('sub', []) | selectattr('type', '!=', 'voicemail') | list %}
{% if active_subs %}
exten => {{ ext.public }},1,NoOp(Ring group for {{ ext.name }})
{% if ext.get('ring_strategy', 'sequential') == 'parallel' %}
exten => {{ ext.public }},n,Dial({% for sub in active_subs %}SIP/{{ tenant.domain }}-{{ sub.number }}{% if not loop.last %}&{% endif %}{% endfor %},30)
{% else %}
exten => {{ ext.public }},n,Dial({% for sub in active_subs|sort(attribute='priority') %}SIP/{{ tenant.domain }}-{{ sub.number }}{% if not loop.last %}&{% endif %}{% endfor %},30)
{% endif %}
exten => {{ ext.public }},n,Voicemail({{ ext.public }}@{{ tenant.domain }},u)
exten => {{ ext.public }},n,Hangup()
{% endif %}
{% endfor %}

[{{ tenant.domain }}-incoming]
exten => _X.,1,NoOp(Incoming call to {{ tenant.domain }})
same => n,Goto({{ tenant.domain }}-internal,s,1)
