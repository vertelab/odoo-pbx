<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Gear button shown next to `config_display` on the Devices list on
         My Profile. Opens the per-parameter SIP configuration dialog. -->
    <t t-name="pbx_tenant.PbxSipConfigButton">
        <button
            type="button"
            class="btn btn-link o_pbx_sip_config_btn"
            t-att-title="env._t('SIP configuration')"
            t-on-click.stop.prevent="openDialog"
        >
            <i class="fa fa-cog" role="img" aria-label="SIP configuration"/>
        </button>
    </t>

    <!-- Per-parameter SIP configuration, grouped by the template's `section`.
         A template picker at the top lets the user switch software/hardware
         without leaving the dialog: choosing one writes template_id on the
         device and the dialog reopens with the freshly resolved config.
         Secret-looking parameters (password/secret) are masked until the
         user reveals them. Falls back to the readable one-liner when the
         device has no template at all. -->
    <t t-name="pbx_tenant.PbxSipConfigDialog">
        <Dialog title="props.title" size="'md'">
            <div t-if="props.templates and props.templates.length > 1"
                 class="mb-3 o_pbx_template_picker">
                <label for="pbx_template_select" class="form-label">
                    Device template
                </label>
                <select
                    id="pbx_template_select"
                    class="form-select"
                    t-on-change="onTemplateChange"
                >
                    <option value="" t-att-selected="!props.selectedTemplateId">
                        Automatic (catalog default)
                    </option>
                    <t t-foreach="props.templates" t-as="tpl" t-key="tpl.id">
                        <option
                            t-att-value="tpl.id"
                            t-att-selected="tpl.id === props.selectedTemplateId"
                        >
                            <t t-esc="tpl.name"/>
                            <t t-if="tpl.vendor"> — <t t-esc="tpl.vendor"/></t>
                        </option>
                    </t>
                </select>
            </div>

            <t t-if="props.sections and props.sections.length">
                <div t-foreach="props.sections" t-as="group" t-key="group.name"
                     class="o_pbx_sip_section mb-3">
                    <h6 class="o_pbx_sip_section_title text-muted mb-2"
                        t-esc="group.name"/>
                    <table class="table table-sm o_pbx_sip_config_table mb-0">
                        <tbody>
                            <tr t-foreach="group.rows" t-as="row" t-key="row.key">
                                <th scope="row" class="o_pbx_sip_config_label">
                                    <t t-esc="row.label"/>
                                </th>
                                <td class="o_pbx_sip_config_value">
                                    <t t-if="row.secret and not isRevealed(row.key)">
                                        <span class="text-muted">••••••••</span>
                                        <button
                                            type="button"
                                            class="btn btn-link btn-sm p-0 ms-2"
                                            t-on-click="() => this.toggleReveal(row.key)"
                                        ><i class="fa fa-eye" role="img" aria-label="Show"/></button>
                                    </t>
                                    <t t-elif="row.secret">
                                        <code t-esc="row.value"/>
                                        <button
                                            type="button"
                                            class="btn btn-link btn-sm p-0 ms-2"
                                            t-on-click="() => this.toggleReveal(row.key)"
                                        ><i class="fa fa-eye-slash" role="img" aria-label="Hide"/></button>
                                        <button
                                            type="button"
                                            class="btn btn-link btn-sm p-0 ms-1"
                                            t-on-click="() => this.onCopy(row.value)"
                                        ><i class="fa fa-copy" role="img" aria-label="Copy"/></button>
                                    </t>
                                    <t t-else="">
                                        <code t-esc="row.value"/>
                                        <button
                                            type="button"
                                            class="btn btn-link btn-sm p-0 ms-2"
                                            t-on-click="() => this.onCopy(row.value)"
                                        ><i class="fa fa-copy" role="img" aria-label="Copy"/></button>
                                    </t>
                                    <div t-if="row.help" class="text-muted small" t-esc="row.help"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
            <t t-elif="props.fallback">
                <p class="text-muted mb-1">No device template — showing the plain
                    configuration line:</p>
                <code t-esc="props.fallback"/>
            </t>
            <t t-else="">
                <p class="text-muted mb-0">No SIP configuration available for this
                    device.</p>
            </t>

            <div t-if="props.extensionId" class="mt-3 pt-2 border-top d-flex align-items-center">
                <span class="text-muted small">The password applies to every device
                    on the extension.</span>
                <button
                    type="button"
                    class="btn btn-link p-0 ms-2 o_pbx_rotate_password"
                    title="Generate a new SIP password"
                    t-on-click="() => this.onRotatePassword(props.extensionId)"
                >
                    <i class="fa fa-refresh" role="img" aria-label="Generate a new SIP password"/>
                </button>
            </div>
        </Dialog>
    </t>

</templates>
