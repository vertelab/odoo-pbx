<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pbx_tenant.PbxSyncSystray">
        <div
            class="o_pbx_sync_systray"
            t-att-title="pbxSyncTitle()"
        >
            <button
                t-if="canSync"
                type="button"
                class="btn btn-link o_pbx_sync_btn"
                t-attf-class="o_pbx_sync_btn {{pbxSyncClass()}}"
                t-on-click="_sync"
                t-att-disabled="state.syncing"
            >
                <i t-attf-class="fa {{pbxSyncIcon()}}"/>
                <span t-if="state.syncState === 'sent'" class="o_pbx_sync_badge" title="Skickat — väntar på bekräftelse"/>
                <span t-if="state.syncState === 'error'" class="o_pbx_sync_badge o_pbx_sync_badge_error" title="Fel vid applicering"/>
            </button>
            <i
                t-else=""
                t-attf-class="fa {{pbxSyncIcon()}} o_pbx_sync_btn"
                t-att-title="pbxSyncTitle()"
            />
        </div>
    </t>
</templates>
