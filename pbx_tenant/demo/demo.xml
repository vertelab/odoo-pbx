<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Företagets SIP-domän (multicompany: domänen ligger på res.company) -->
        <record id="base.main_company" model="res.company">
            <field name="pbx_domain">vertel.test</field>
            <field name="pbx_server_host">localhost</field>
        </record>

        <!-- Anknytningar med beskrivning (Operator Panel-grid).
             Instansen administrerar bara sin egen växel (company). -->
        <record id="demo_ext_reception" model="pbx.extension">
            <field name="public_number">10</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="callerid_name">Reception</field>
            <field name="description">Reception</field>
            <field name="is_receptionist">True</field>
        </record>

        <record id="demo_ext_anna" model="pbx.extension">
            <field name="public_number">11</field>
            <field name="user_id" ref="base.user_demo"/>
            <field name="callerid_name">Anna</field>
            <field name="description">Anna – Support</field>
        </record>

        <record id="demo_ext_bjorn" model="pbx.extension">
            <field name="public_number">12</field>
            <field name="callerid_name">Björn</field>
            <field name="description">Björn – Ledning</field>
        </record>

        <!-- Sub-anknytningar -->
        <record id="demo_sub_reception_1" model="pbx.sub_extension">
            <field name="extension_id" ref="demo_ext_reception"/>
            <field name="number">101</field>
            <field name="label">Odoo</field>
            <field name="type">browser</field>
            <field name="sequence">1</field>
        </record>
        <record id="demo_sub_anna_1" model="pbx.sub_extension">
            <field name="extension_id" ref="demo_ext_anna"/>
            <field name="number">111</field>
            <field name="label">Yealink</field>
            <field name="type">hardware</field>
            <field name="mac_address">00:1B:66:11:22:33</field>
            <field name="device_model">T46S</field>
            <field name="sequence">1</field>
        </record>
        <record id="demo_sub_anna_2" model="pbx.sub_extension">
            <field name="extension_id" ref="demo_ext_anna"/>
            <field name="number">112</field>
            <field name="label">Mobil</field>
            <field name="type">mobile</field>
            <field name="sequence">2</field>
        </record>
        <record id="demo_sub_bjorn_1" model="pbx.sub_extension">
            <field name="extension_id" ref="demo_ext_bjorn"/>
            <field name="number">121</field>
            <field name="label">Desktop</field>
            <field name="type">desktop</field>
            <field name="sequence">1</field>
        </record>
        <record id="demo_sub_bjorn_2" model="pbx.sub_extension">
            <field name="extension_id" ref="demo_ext_bjorn"/>
            <field name="number">122</field>
            <field name="label">Röstbrevlåda</field>
            <field name="type">voicemail</field>
            <field name="sequence">2</field>
        </record>

        <!-- Admin får receptionist-anknytningen (Operator Panel visar allt) + PBX-grupper -->
        <record id="base.user_admin" model="res.users">
            <field name="pbx_extension_id" ref="demo_ext_reception"/>
            <field name="groups_id" eval="[(4, ref('pbx_base.group_pbx_operator')), (4, ref('pbx_base.group_pbx_admin'))]"/>
        </record>

        <!-- Test-token för webhook (daemon → Odoo) -->
        <record id="demo_webhook_token" model="ir.config_parameter">
            <field name="key">pbx.webhook.token</field>
            <field name="value">test-token-123</field>
        </record>
    </data>


<!-- Device Templates (pbx-device-templates): seedade i pbx_base (data/device_template_data.xml) -->

<!-- Tenant som res.partner (pbx-tenant-as-partner) -->
<record id="demo_tenant_partner" model="res.partner">
    <field name="name">Vertel Test</field>
    <field name="is_pbx_tenant">True</field>
    <field name="domain">vertel.test</field>
    <field name="comment">Demotenant för PBX-test.</field>
</record>
</odoo>
