<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Voicemail: a filtered view over pbx.call (pbx_handling = voicemail).
         Voicemails are pbx.call records — there is no separate model. -->

    <record model="ir.ui.view" id="pbx_voicemail_list_view">
        <field name="name">pbx.call.voicemail.list</field>
        <field name="model">pbx.call</field>
        <field name="arch" type="xml">
            <list string="Voicemails" create="false">
                <field name="voicemail_read" widget="boolean_toggle"/>
                <field name="callerid_name" string="Avsändare"/>
                <field name="phone_number" string="Nummer"/>
                <field name="extension_id" string="Anknytning"/>
                <field name="duration" string="Längd (s)"/>
                <field name="start_date" string="Tid"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_voicemail_act_window">
        <field name="name">Voicemails</field>
        <field name="res_model">pbx.call</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pbx_handling', '=', 'voicemail')]</field>
        <field name="context">{'search_default_voicemail': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Inga röstmeddelanden
            </p>
            <p>
                Röstmeddelanden visas här som samtal med hantering
                "Voicemail". Inspelning och transkription finns på samtalet.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_pbx_voicemails"
        name="Voicemails"
        parent="pbx_base.menu_pbx_applications"
        action="pbx_voicemail_act_window"
        sequence="60"
    />
</odoo>
