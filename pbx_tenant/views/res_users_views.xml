<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PBX Extension field on user form -->
    <record model="ir.ui.view" id="res_users_form_extension">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="pbx_extension_id" string="PBX Extension"/>
            </xpath>
        </field>
    </record>

    <!-- Self-service: PBX Settings tab on user profile -->
    <record model="ir.ui.view" id="res_users_form_pbx_settings">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="PBX Settings" name="pbx_settings"
                      invisible="[('pbx_extension_id', '=', False)]">
                    <group>
                        <field name="pbx_extension_id" invisible="1"/>
                        <field name="pbx_ring_strategy"/>
                        <field name="pbx_skip_if_busy"/>
                    </group>
                    <group string="Devices (Sub-Extensions)">
                        <field name="pbx_sub_extension_ids" mode="list">
                            <list editable="bottom">
                                <field name="type" readonly="1"/>
                                <field name="label"/>
                                <field name="number" readonly="1"/>
                                <field name="priority"/>
                                <field name="ring_timeout"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
