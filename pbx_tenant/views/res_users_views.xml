<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PBX Extension field on user form -->
    <record model="ir.ui.view" id="res_users_form_extension">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="pbx_extension_id" string="PBX Extension"/>
            </xpath>
        </field>
    </record>

    <!-- Self-service: Follow-me settings under the VOIP tab (full user form) -->
    <record model="ir.ui.view" id="res_users_form_pbx_settings">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Hide voip_oca's PBX/Username/Password — the values are set automatically
                 by pbx_base (implicit Odoo VOIP device + shared password). -->
            <xpath expr="//page[@name='voip']/group[field[@name='voip_pbx_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='voip']" position="inside">
                <notebook>
                    <page string="Settings" name="pbx_settings">
                        <group name="follow_me" colspan="2">
                            <div class="text-muted" invisible="pbx_extension_id">No PBX extension linked to the user.</div>
                            <field name="pbx_extension_id" invisible="1"/>
                            <field name="pbx_ring_strategy"/>
                            <field name="pbx_respect_schedule"/>
                            <field name="pbx_respect_calendar"/>
                        </group>
                    </page>
                    <page string="Devices" name="pbx_devices">
                        <field name="pbx_sub_extension_ids" string="" nolabel="1" mode="list">
                            <list editable="bottom">
                                <field name="sequence" string="Sequence" widget="handle"/>
                                <field name="type"/>
                                <field name="label"/>
                                <field name="ring_timeout"/>
                                <field name="config_display" readonly="1"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Same, but on the simple profile view (My Profile) that Odoo uses
         when the user views their own user. -->
    <record model="ir.ui.view" id="res_users_form_simple_pbx_settings">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <!-- Hide voip_oca's PBX/Username/Password — the values are set automatically. -->
            <xpath expr="//page[@name='voip']/group[field[@name='voip_pbx_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='voip']" position="inside">
                <notebook>
                    <page string="Settings" name="pbx_settings">
                        <group name="follow_me" colspan="2">
                            <div class="text-muted" invisible="pbx_extension_id">No PBX extension linked to the user.</div>
                            <field name="pbx_extension_id" invisible="1"/>
                            <field name="pbx_ring_strategy"/>
                            <field name="pbx_respect_schedule"/>
                            <field name="pbx_respect_calendar"/>
                        </group>
                    </page>
                    <page string="Devices" name="pbx_devices">
                        <field name="pbx_sub_extension_ids" string="" nolabel="1" mode="list">
                            <list editable="bottom">
                                <field name="sequence" string="Sequence" widget="handle"/>
                                <field name="type"/>
                                <field name="label"/>
                                <field name="ring_timeout"/>
                                <field name="config_display" readonly="1"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
