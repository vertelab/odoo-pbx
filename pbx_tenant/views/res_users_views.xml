<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PBX Extension field on user form -->
    <record model="ir.ui.view" id="res_users_form_extension">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="pbx_extension_id" string="PBX Extension"/>
            </xpath>
        </field>
    </record>

    <!-- Self-service: Follow-me settings under the VOIP tab (full user form) -->
    <record model="ir.ui.view" id="res_users_form_pbx_settings">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='voip']" position="inside">
                <group string="Follow-me" name="follow_me" colspan="2">
                    <div class="text-muted" invisible="pbx_extension_id">Ingen PBX-anknytning kopplad till användaren.</div>
                    <field name="pbx_extension_id" invisible="1"/>
                    <field name="pbx_ring_strategy"/>
                    <field name="pbx_skip_if_busy"/>
                </group>
                <group string="Enheter" name="follow_me_devices" colspan="2">
                    <field name="pbx_sub_extension_ids" string="" mode="list">
                        <list editable="bottom">
                            <field name="priority" string="Ringordning" widget="handle"/>
                            <field name="type" readonly="1"/>
                            <field name="label"/>
                            <field name="ring_timeout"/>
                            <field name="sip_config_display" readonly="1"/>
                            <field name="active"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Samma, men på den enkla profilvyn (Min profil) som Odoo använder
         när användaren ser sin egen användare. -->
    <record model="ir.ui.view" id="res_users_form_simple_pbx_settings">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='voip']" position="inside">
                <group string="Follow-me" name="follow_me" colspan="2">
                    <div class="text-muted" invisible="pbx_extension_id">Ingen PBX-anknytning kopplad till användaren.</div>
                    <field name="pbx_extension_id" invisible="1"/>
                    <field name="pbx_ring_strategy"/>
                    <field name="pbx_skip_if_busy"/>
                </group>
                <group string="Enheter" name="follow_me_devices" colspan="2">
                    <field name="pbx_sub_extension_ids" string="" mode="list">
                        <list editable="bottom">
                            <field name="priority" string="Ringordning" widget="handle"/>
                            <field name="type" readonly="1"/>
                            <field name="label"/>
                            <field name="ring_timeout"/>
                            <field name="sip_config_display" readonly="1"/>
                            <field name="active"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
