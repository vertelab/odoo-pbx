<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pbx_conference.PbxConferencePanel">
        <div
            class="o_pbx_fop2_tile o_pbx_conference_tile o_pbx_state_gray"
            title="Gå in i konferensrum"
            t-on-click="() => this.join()"
            t-if="props.conference"
        >
            <div class="o_pbx_fop2_num"><t t-esc="props.conference.key"/></div>
            <div class="o_pbx_fop2_desc"><t t-esc="props.conference.name"/></div>
            <div class="o_pbx_fop2_badge" t-if="props.conference.has_pin">🔒 pin</div>
        </div>
    </t>
</templates>
