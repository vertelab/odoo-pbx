<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_extension_form_view">
        <field name="model">pbx.extension</field>
        <field name="arch" type="xml">
            <form string="Extension">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="public_number" widget="text" options="{'line_breaks': False}"
                                   placeholder="Anknytningsnummer…"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" string="Odoo-användare" widget="many2one_avatar_user"/>
                            <field name="callerid_name" string="Namn på nummerpresentation"/>
                            <field name="description" help="Visas i Operator Panel (fallback: callerid-namn → användarnamn → nummer)."/>
                            <field name="password" string="SIP-lösenord" readonly="1"
                                   help="Delat SIP-lösenord för alla enheter. Rotation via kugghjuls-ikon (Design A)."/>
                        </group>
                        <group>
                            <field name="ring_strategy"/>
                            <field name="respect_schedule"/>
                            <field name="respect_calendar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Enheter" name="devices">
                            <field name="sub_extension_ids" string="" nolabel="1" mode="list">
                                <list editable="bottom">
                                    <field name="sequence" string="Sequence" widget="handle"/>
                                    <field name="type"/>
                                    <field name="label"/>
                                    <field name="number" readonly="1"/>
                                    <field name="ring_timeout"/>
                                    <field name="transport"/>
                                    <field name="mac_address" optional="show"/>
                                    <field name="device_model" optional="hide"/>
                                    <field name="provisioning_token" readonly="1" optional="hide"/>
                                    <field name="sip_config_display" readonly="1" optional="hide"/>
                                    <field name="active" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pbx_extension_list_view">
        <field name="model">pbx.extension</field>
        <field name="arch" type="xml">
            <list>
                <field name="public_number"/>
                <field name="user_id"/>
                <field name="callerid_name"/>
                <field name="description"/>
                <field name="ring_strategy"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_extension_act_window">
        <field name="name">Extensions</field>
        <field name="res_model">pbx.extension</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
