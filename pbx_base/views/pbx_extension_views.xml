<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_extension_form_view">
        <field name="model">pbx.extension</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="public_number"/>
                        <field name="user_id"/>
                        <field name="callerid_name"/>
                        <field name="description"/>
                        <field name="is_receptionist"/>
                        <field name="ring_strategy"/>
                        <field name="respect_schedule"/>
                        <field name="respect_calendar"/>
                    </group>
                    <group string="Enheter">
                        <field name="sub_extension_ids" mode="list">
                            <list editable="bottom">
                                <field name="sequence" string="Sequence" widget="handle"/>
                                <field name="type"/>
                                <field name="label"/>
                                <field name="number" readonly="1"/>
                                <field name="ring_timeout"/>
                                <field name="transport"/>
                                <field name="mac_address" optional="show"/>
                                <field name="device_model" optional="hide"/>
                                <field name="provisioning_token" readonly="1" optional="hide"/>
                                <field name="sip_config_display" readonly="1" optional="hide"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pbx_extension_list_view">
        <field name="model">pbx.extension</field>
        <field name="arch" type="xml">
            <list>
                <field name="public_number"/>
                <field name="user_id"/>
                <field name="callerid_name"/>
                <field name="description"/>
                <field name="is_receptionist"/>
                <field name="ring_strategy"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_extension_act_window">
        <field name="name">Extensions</field>
        <field name="res_model">pbx.extension</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
