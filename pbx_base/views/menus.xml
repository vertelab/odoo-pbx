<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PBX — main menu. Visible to PBX Operator, PBX Office and PBX Admin.
         FOP (operator panel) is added by pbx_tenant under this root.
         Applications (queues/IVR) is filled by pbx_queue/pbx_ivr.
         Configuration is PBX Admin only (+ Servers/Tenants = central). -->
    <menuitem
        id="menu_pbx_root"
        name="PBX"
        sequence="90"
        groups="pbx_base.group_pbx_operator,pbx_base.group_pbx_office,pbx_base.group_pbx_admin"
    />

    <!-- Applications: queues, IVR etc. (office + admin) -->
    <menuitem
        id="menu_pbx_applications"
        name="Applications"
        parent="menu_pbx_root"
        sequence="20"
        groups="pbx_base.group_pbx_office,pbx_base.group_pbx_admin"
    />

    <!-- Configuration: settings + domain-local entities (admin only) -->
    <menuitem
        id="menu_pbx_configuration"
        name="Configuration"
        parent="menu_pbx_root"
        sequence="30"
        groups="pbx_base.group_pbx_admin"
    />

    <menuitem
        id="menu_pbx_settings"
        name="Settings"
        parent="menu_pbx_configuration"
        action="pbx_config_settings_action"
        sequence="10"
    />

    <!-- Sync: skicka konfigurationen till Asterisk (via MQ → pbx_ami_daemon) -->
    <record id="action_pbx_sync" model="ir.actions.server">
        <field name="name">Sync to Asterisk</field>
        <field name="model_id" ref="model_pbx_config_generator"/>
        <field name="state">code</field>
        <field name="code">
result = env['pbx.config.generator'].sync_current_company()
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'PBX Sync',
        'message': result.get('message', ''),
        'type': 'success' if result.get('ok') else 'danger',
        'sticky': True,
    },
}
        </field>
    </record>
    <menuitem
        id="menu_pbx_sync"
        name="Sync"
        parent="menu_pbx_configuration"
        action="action_pbx_sync"
        sequence="5"
        groups="pbx_base.group_pbx_admin"
    />

    <menuitem
        id="menu_pbx_extensions"
        name="Extensions"
        parent="menu_pbx_applications"
        action="pbx_extension_act_window"
        sequence="10"
    />

    <menuitem
        id="menu_pbx_call_history"
        name="Call History"
        parent="menu_pbx_applications"
        action="pbx_call_act_window"
        sequence="5"
    />

    <menuitem
        id="menu_pbx_trunks"
        name="SIP Trunks"
        parent="menu_pbx_configuration"
        action="pbx_trunk_act_window"
        sequence="30"
    />

    <menuitem
        id="menu_pbx_inbound_routes"
        name="Inbound Routes"
        parent="menu_pbx_configuration"
        action="pbx_inbound_route_act_window"
        sequence="40"
    />

    <menuitem
        id="menu_pbx_outbound_routes"
        name="Outbound Routes"
        parent="menu_pbx_configuration"
        action="pbx_outbound_route_act_window"
        sequence="50"
    />
</odoo>
