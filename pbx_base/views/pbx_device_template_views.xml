<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Device Templates: list + form -->
    <record id="pbx_device_template_list" model="ir.ui.view">
        <field name="name">pbx.device.template.list</field>
        <field name="model">pbx.device.template</field>
        <field name="arch" type="xml">
            <list string="Device Templates" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="device_type"/>
                <field name="vendor" optional="show"/>
                <field name="model_match" optional="hide"/>
                <field name="transport" optional="hide"/>
                <field name="user_selectable" optional="show"/>
                <field name="default_for_type" optional="show"/>
                <field name="company_id" optional="hide"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="pbx_device_template_form" model="ir.ui.view">
        <field name="name">pbx.device.template.form</field>
        <field name="model">pbx.device.template</field>
        <field name="arch" type="xml">
            <form string="Device Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_type"/>
                            <field name="vendor"/>
                            <field name="transport"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Catalog">
                            <field name="sequence"/>
                            <field name="user_selectable"/>
                            <field name="default_for_type"/>
                            <field name="model_match"
                                   placeholder="e.g. T46S or T4xS*"/>
                        </group>
                        <group>
                            <field name="config_template" widget="jsonb" options="{'mode': 'tree', 'schema': {}}"/>
                        </group>
                    </group>
                    <group string="Parametrar i mallen" colspan="2">
                        <field name="config_template" widget="code" options="{'mode': 'javascript'}"/>
                    </group>
                    <group string="Codecs (default)" colspan="2">
                        <field name="codec_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" string="Order" widget="handle"/>
                                <field name="codec_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pbx_device_template_action" model="ir.actions.act_window">
        <field name="name">Device Templates</field>
        <field name="res_model">pbx.device.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="pbx_device_template_search" model="ir.ui.view">
        <field name="name">pbx.device.template.search</field>
        <field name="model">pbx.device.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="device_type"/>
                <field name="vendor"/>
                <field name="model_match"/>
                <filter name="filter_user_selectable" string="User selectable"
                        domain="[('user_selectable', '=', True)]"/>
                <filter name="filter_default" string="Defaults"
                        domain="[('default_for_type', '=', True)]"/>
                <group>
                    <filter name="group_device_type" string="Type"
                            context="{'group_by': 'device_type'}"/>
                    <filter name="group_vendor" string="Vendor"
                            context="{'group_by': 'vendor'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Meny: PBX → Konfiguration → Enhetsmallar -->
    <menuitem
        id="menu_pbx_device_template"
        name="Enhetsmallar"
        parent="menu_pbx_configuration"
        action="pbx_device_template_action"
        sequence="20"
        groups="pbx_base.group_pbx_admin,pbx_base.group_pbx_office"
    />
</odoo>
