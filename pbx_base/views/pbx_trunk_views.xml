<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_trunk_form_view">
        <field name="model">pbx.trunk</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="host"/>
                        <field name="port"/>
                        <field name="username"/>
                        <field name="secret" password="True"/>
                        <field name="channels"/>
                        <field name="callerid"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pbx_trunk_list_view">
        <field name="model">pbx.trunk</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="host"/>
                <field name="channels"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_trunk_act_window">
        <field name="name">SIP Trunks</field>
        <field name="res_model">pbx.trunk</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
