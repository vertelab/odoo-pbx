<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_pbx" model="ir.ui.view">
        <field name="name">res.company.form.pbx</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="PBX / Asterisk" name="pbx">
                    <group>
                        <field name="pbx_domain"/>
                        <field name="pbx_server_host"/>
                        <field name="pbx_api_key" password="True"/>
                        <field name="pbx_odoo_url"/>
                    </group>
                    <group>
                        <field name="pbx_sip_port"/>
                        <field name="pbx_sip_ws_port"/>
                        <field name="pbx_ws_server"/>
                        <field name="pbx_turn_enabled"/>
                        <field name="pbx_config_sync_state" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
