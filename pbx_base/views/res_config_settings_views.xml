<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pbx_config_settings_action" model="ir.actions.act_window">
        <field name="name">PBX Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'pbx', 'bin_size': False}</field>
    </record>

    <record id="res_config_settings_view_form_pbx" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pbx</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="PBX" string="PBX" name="pbx">
                    <field name="pbx_config_managed" invisible="1"/>

                    <block title="Grundinställningar">
                        <div class="row">
                            <div class="col-lg-6">
                                <setting string="Min telefon-växel">
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label string="SIP Domain" for="pbx_domain" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_domain" class="col-lg-6" readonly="pbx_config_managed"/>
                                        </div>
                                        <div class="row mt16">
                                            <label string="PBX Server" for="pbx_server_host" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_server_host" class="col-lg-6" readonly="pbx_config_managed"/>
                                        </div>
                                        <div class="row mt16">
                                            <label string="SIP Port" for="pbx_sip_port" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_sip_port" class="col-lg-6" readonly="pbx_config_managed"/>
                                        </div>
                                        <div class="row mt16">
                                            <label string="WebSocket Port" for="pbx_sip_ws_port" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_sip_ws_port" class="col-lg-6" readonly="pbx_config_managed"/>
                                        </div>
                                        <div class="row mt16">
                                            <label string="WebSocket Server (override)" for="pbx_ws_server" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_ws_server" class="col-lg-6" readonly="pbx_config_managed"/>
                                        </div>
                                    </div>
                                </setting>
                            </div>
                            <div class="col-lg-6">
                                <setting string="Säkerhet">
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label string="API Key" for="pbx_api_key" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_api_key" class="col-lg-6" password="True" readonly="pbx_config_managed"/>
                                        </div>
                                        <div class="row mt16">
                                            <label string="TURN aktiverad" for="pbx_turn_enabled" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_turn_enabled" class="col-lg-6" readonly="pbx_config_managed"/>
                                        </div>
                                        <div class="row mt16" invisible="not pbx_turn_enabled">
                                            <label string="TURN Server" for="pbx_turn_server" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_turn_server" class="col-lg-6" readonly="pbx_config_managed"/>
                                        </div>
                                    </div>
                                </setting>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <setting string="Meddelandekö (RabbitMQ)">
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label string="Port" for="pbx_mq_port" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_mq_port" class="col-lg-6" readonly="pbx_config_managed"/>
                                        </div>
                                    </div>
                                </setting>
                            </div>
                            <div class="col-lg-6">
                                <setting string="Webhook (daemon → Odoo)">
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label string="Endpoint" for="pbx_webhook_url" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_webhook_url" class="col-lg-6" readonly="1"/>
                                        </div>
                                        <div class="row mt16">
                                            <label string="PBX Webhook Token" for="pbx_webhook_token" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_webhook_token" class="col-lg-6" readonly="1"/>
                                            <label string="SIP-lösenordslängd" for="pbx_sip_password_length" class="col-lg-6 o_light_label"/>
                                            <field name="pbx_sip_password_length" class="col-lg-6"/>
                                        </div>
                                        <div class="row mt16">
                                            <button name="action_generate_webhook_token" type="object"
                                                    string="Generera ny token" icon="fa-refresh" class="btn-link"/>
                                        </div>
                                    </div>
                                </setting>
                            </div>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
