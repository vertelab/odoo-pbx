<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pbx_config_settings_action" model="ir.actions.act_window">
        <field name="name">PBX Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <record id="res_config_settings_view_form_pbx" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pbx</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="PBX" string="PBX" name="pbx">
                    <block title="Grundinställningar">
                        <setting string="Min telefon-växel">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label string="SIP Domain" for="pbx_domain" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_domain" class="col-lg-3"/>
                                </div>
                                <div class="row mt16">
                                    <label string="PBX Server" for="pbx_server_host" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_server_host" class="col-lg-3"/>
                                </div>
                                <div class="row mt16">
                                    <label string="API Key" for="pbx_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_api_key" class="col-lg-3"/>
                                </div>
                                <div class="row mt16">
                                    <label string="Odoo URL" for="pbx_odoo_url" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_odoo_url" class="col-lg-3"/>
                                </div>
                                <div class="row mt16">
                                    <label string="SIP Port" for="pbx_sip_port" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_sip_port" class="col-lg-3"/>
                                </div>
                                <div class="row mt16">
                                    <label string="STUN aktiverad" for="pbx_stun_enabled" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_stun_enabled" class="col-lg-3"/>
                                </div>
                                <div class="row mt16" invisible="not pbx_stun_enabled">
                                    <label string="STUN Server" for="pbx_stun_server" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_stun_server" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Leasavtal (från central förvaltning)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label string="Plan" for="pbx_tenant_plan" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_tenant_plan" class="col-lg-3"/>
                                </div>
                                <div class="row mt16">
                                    <label string="Max Extensions" for="pbx_tenant_max_extensions" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_tenant_max_extensions" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="RabbitMQ (actions + config-transport)">
                        <setting string="Message broker">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label string="Host" for="pbx_mq_host" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_mq_host" class="col-lg-3"/>
                                </div>
                                <div class="row mt16">
                                    <label string="Port" for="pbx_mq_port" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_mq_port" class="col-lg-3"/>
                                </div>
                                <div class="row mt16">
                                    <label string="User" for="pbx_mq_user" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_mq_user" class="col-lg-3"/>
                                </div>
                                <div class="row mt16">
                                    <label string="Password" for="pbx_mq_password" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_mq_password" class="col-lg-3"/>
                                </div>
                                <div class="row mt16">
                                    <label string="Vhost" for="pbx_mq_vhost" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_mq_vhost" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Webhook (daemon → Odoo)">
                        <setting string="PBX Webhook Token">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label string="Bearer-token" for="pbx_webhook_token" class="col-lg-3 o_light_label"/>
                                    <field name="pbx_webhook_token" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
