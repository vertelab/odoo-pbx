<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grundroll: får använda Operator Panel (FOP), ser varken
         Applications eller Configuration. -->
    <record id="group_pbx_operator" model="res.groups">
        <field name="name">PBX Operator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pbx_office" model="res.groups">
        <field name="name">PBX Office</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_pbx_operator'))]"/>
    </record>

    <record id="group_pbx_admin" model="res.groups">
        <field name="name">PBX Admin</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_pbx_office'))]"/>
    </record>

    <!-- Central administration (Asterisk servers + tenant/domain leases).
         Only assigned in the management system (Ledningssystem); customer
         Odoo instances never see the Servers/Tenants menus. -->
    <record id="group_pbx_central" model="res.groups">
        <field name="name">PBX Central Admin</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_pbx_admin'))]"/>
    </record>

    <!-- Record Rules: Tenant isolation by company_id -->
    <record id="rule_pbx_tenant_company" model="ir.rule">
        <field name="name">PBX Tenant: company isolation</field>
        <field name="model_id" ref="model_pbx_tenant"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_extension_company" model="ir.rule">
        <field name="name">PBX Extension: company isolation</field>
        <field name="model_id" ref="model_pbx_extension"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_trunk_company" model="ir.rule">
        <field name="name">PBX Trunk: company isolation</field>
        <field name="model_id" ref="model_pbx_trunk"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_inbound_route_company" model="ir.rule">
        <field name="name">PBX Inbound Route: company isolation</field>
        <field name="model_id" ref="model_pbx_inbound_route"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_outbound_route_company" model="ir.rule">
        <field name="name">PBX Outbound Route: company isolation</field>
        <field name="model_id" ref="model_pbx_outbound_route"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_extension_own" model="ir.rule">
        <field name="name">PBX Extension: own extension only</field>
        <field name="model_id" ref="model_pbx_extension"/>
        <field name="groups" eval="[(6, 0, [ref('group_pbx_operator')])]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_pbx_sub_extension_own" model="ir.rule">
        <field name="name">PBX Sub-Extension: via own extension</field>
        <field name="model_id" ref="model_pbx_sub_extension"/>
        <field name="groups" eval="[(6, 0, [ref('group_pbx_operator')])]"/>
        <field name="domain_force">[('extension_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
