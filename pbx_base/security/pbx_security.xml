<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_pbx_admin" model="res.groups">
        <field name="name">PBX Administrator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="group_pbx_operator" model="res.groups">
        <field name="name">PBX Operator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- Record Rules: Tenant isolation by company_id -->
    <record id="rule_pbx_tenant_company" model="ir.rule">
        <field name="name">PBX Tenant: company isolation</field>
        <field name="model_id" ref="model_pbx_tenant"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_extension_company" model="ir.rule">
        <field name="name">PBX Extension: company isolation</field>
        <field name="model_id" ref="model_pbx_extension"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_trunk_company" model="ir.rule">
        <field name="name">PBX Trunk: company isolation</field>
        <field name="model_id" ref="model_pbx_trunk"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_inbound_route_company" model="ir.rule">
        <field name="name">PBX Inbound Route: company isolation</field>
        <field name="model_id" ref="model_pbx_inbound_route"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_outbound_route_company" model="ir.rule">
        <field name="name">PBX Outbound Route: company isolation</field>
        <field name="model_id" ref="model_pbx_outbound_route"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>
</odoo>
