<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Base role: may use the Operator Panel (FOP), sees neither
         Applications nor Configuration. -->
    <record id="group_pbx_operator" model="res.groups">
        <field name="name">PBX Operator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pbx_office" model="res.groups">
        <field name="name">PBX Office</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_pbx_operator'))]"/>
    </record>

    <record id="group_pbx_admin" model="res.groups">
        <field name="name">PBX Admin</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_pbx_office'))]"/>
    </record>


    <!-- Record Rules: Tenant isolation by company_id -->
    <record id="rule_pbx_extension_company" model="ir.rule">
        <field name="name">PBX Extension: company isolation</field>
        <field name="model_id" ref="model_pbx_extension"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_trunk_company" model="ir.rule">
        <field name="name">PBX Trunk: company isolation</field>
        <field name="model_id" ref="model_pbx_trunk"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_inbound_route_company" model="ir.rule">
        <field name="name">PBX Inbound Route: company isolation</field>
        <field name="model_id" ref="model_pbx_inbound_route"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_outbound_route_company" model="ir.rule">
        <field name="name">PBX Outbound Route: company isolation</field>
        <field name="model_id" ref="model_pbx_outbound_route"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="rule_pbx_extension_own" model="ir.rule">
        <field name="name">PBX Extension: own extension only</field>
        <field name="model_id" ref="model_pbx_extension"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_pbx_sub_extension_own" model="ir.rule">
        <field name="name">PBX Sub-Extension: via own extension</field>
        <field name="model_id" ref="model_pbx_sub_extension"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="domain_force">[('extension_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Office/Admin: full access to all extensions (administers the PBX).
         Odoo 18 combines global rules (AND) with group rules (OR) —
         without these rules the operator restriction (own extension)
         would also hit office/admin via implied groups. -->
    <record id="rule_pbx_extension_all" model="ir.rule">
        <field name="name">PBX Extension: full access (office/admin)</field>
        <field name="model_id" ref="model_pbx_extension"/>
        <field name="groups" eval="[(6, 0, [ref('group_pbx_office'), ref('group_pbx_admin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_pbx_sub_extension_all" model="ir.rule">
        <field name="name">PBX Sub-Extension: full access (office/admin)</field>
        <field name="model_id" ref="model_pbx_sub_extension"/>
        <field name="groups" eval="[(6, 0, [ref('group_pbx_office'), ref('group_pbx_admin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Calls (pbx.call): internal users see their own calls (My
         Calls + voicemail activity → pbx.call); office/admin see all. -->
    <record id="rule_pbx_call_own" model="ir.rule">
        <field name="name">PBX Call: own calls only</field>
        <field name="model_id" ref="model_pbx_call"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_pbx_call_all" model="ir.rule">
        <field name="name">PBX Call: full access (office/admin)</field>
        <field name="model_id" ref="model_pbx_call"/>
        <field name="groups" eval="[(6, 0, [ref('group_pbx_office'), ref('group_pbx_admin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
