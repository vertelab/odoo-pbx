<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Codec catalogue (pbx-codecs). Default seed with free codecs:
         g722 → ulaw → alaw → opus. G.729 is NOT in the seed (licensed module
         in Asterisk). Video (h264/vp8) exists but is disabled until video is
         used. "What exists" is adjusted against the Salt-pushed
         pbx.codecs.available (see pbx_codec._sync_from_available). -->
    <data noupdate="1">
        <record id="codec_g722" model="pbx.codec">
            <field name="name">g722</field>
            <field name="kind">audio</field>
            <field name="priority">10</field>
            <field name="description">Wideband telephony / HD audio (64 kbps)</field>
        </record>
        <record id="codec_ulaw" model="pbx.codec">
            <field name="name">ulaw</field>
            <field name="kind">audio</field>
            <field name="priority">20</field>
            <field name="description">G.711u (PCMU) — standard bearer tone</field>
        </record>
        <record id="codec_alaw" model="pbx.codec">
            <field name="name">alaw</field>
            <field name="kind">audio</field>
            <field name="priority">30</field>
            <field name="description">G.711a (PCMA) — standard bearer tone</field>
        </record>
        <record id="codec_opus" model="pbx.codec">
            <field name="name">opus</field>
            <field name="kind">audio</field>
            <field name="priority">40</field>
            <field name="description">Opus — high quality, WebRTC standard (Odoo VOIP)</field>
        </record>
        <record id="codec_h264" model="pbx.codec">
            <field name="name">h264</field>
            <field name="kind">video</field>
            <field name="priority">50</field>
            <field name="active">False</field>
            <field name="description">H.264 video (WebRTC)</field>
        </record>
        <record id="codec_vp8" model="pbx.codec">
            <field name="name">vp8</field>
            <field name="kind">video</field>
            <field name="priority">60</field>
            <field name="active">False</field>
            <field name="description">VP8 video (WebRTC)</field>
        </record>
    </data>
</odoo>
