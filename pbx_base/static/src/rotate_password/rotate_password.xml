<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- "Generate new password" icon. Rendered as a view widget so it can sit
         next to the read-only password field in the admin form and inside the
         gear dialog on My Profile. -->
    <t t-name="pbx_base.PbxRotatePassword">
        <button
            type="button"
            class="btn btn-link p-0 ms-2 o_pbx_rotate_password"
            t-att-disabled="!canRotate"
            t-att-title="canRotate ? 'Generate a new SIP password' : 'No extension linked'"
            t-on-click="onClick"
        >
            <i class="fa fa-refresh" role="img" aria-label="Generate a new SIP password"/>
        </button>
    </t>

</templates>
