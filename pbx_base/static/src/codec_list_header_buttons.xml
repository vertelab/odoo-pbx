<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!--
        Header buttons for the pbx.codec catalogue: "Sync" + "Deploy devices".
        Injected into the control-panel-additional-actions slot (where the cog
        wheel sits) → the buttons end up between the cog wheel and the search box
        in the list view. Only for the pbx.codec model (props.resModel check); all
        other list views are unaffected.
    -->
    <t t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']" position="inside">
            <t t-if="props.resModel === 'pbx.codec'">
                <button class="btn btn-secondary ms-1 o_codec_header_btn" type="button"
                        title="Build/update the catalogue from pbx.codecs.available (Salt-pushed)"
                        t-on-click="onClickCodecSync">
                    <i class="fa fa-refresh me-1"/>Sync
                </button>
                <button class="btn btn-secondary ms-1 o_codec_header_btn" type="button"
                        title="Apply the default codec list to all devices without their own selection"
                        t-on-click="onClickCodecDeployDevices">
                    <i class="fa fa-cloud-upload me-1"/>Deploy devices
                </button>
            </t>
        </xpath>
    </t>
</templates>
