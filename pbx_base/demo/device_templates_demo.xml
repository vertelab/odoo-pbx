<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- pbx-device-templates demo data (task 8.2).

         Five users covering the self-service matrix:

           * Adam Admin    — PBX Admin, own extension + browser device
           * Berit Office  — PBX Office, own extension + hardware device
           * Cecilia Operator — PBX Operator, own extension + TWO mobile
                             devices (exercises ring order / follow-me)
           * David NoPBX   — internal user with NO extension (self-service
                             must stay hidden and the gear dialog must not
                             appear)
           * Erik Empty    — PBX Operator with an extension but ZERO devices
                             (exercises the "no device" path: click-to-call
                             must notify instead of dialling)

         Passwords are demo-only and set through `password` on the extension;
         the SIP password itself is generated by the model, so it is not
         pinned here.

         Loaded from pbx_base/__manifest__.py under `demo`. `noupdate="1"` so
         a re-run does not overwrite anything a tester changed by hand. -->
    <data noupdate="1">

        <record id="demo_user_adam" model="res.users">
            <field name="name">Adam Admin</field>
            <field name="login">pbx_demo_adam</field>
            <field name="email">adam.admin@example.com</field>
            <field name="password">pbx_demo_2026</field>
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_user'),
                ref('pbx_base.group_pbx_admin'),
            ])]"/>
        </record>

        <record id="demo_user_berit" model="res.users">
            <field name="name">Berit Office</field>
            <field name="login">pbx_demo_berit</field>
            <field name="email">berit.office@example.com</field>
            <field name="password">pbx_demo_2026</field>
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_user'),
                ref('pbx_base.group_pbx_office'),
            ])]"/>
        </record>

        <record id="demo_user_cecilia" model="res.users">
            <field name="name">Cecilia Operator</field>
            <field name="login">pbx_demo_cecilia</field>
            <field name="email">cecilia.operator@example.com</field>
            <field name="password">pbx_demo_2026</field>
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_user'),
                ref('pbx_base.group_pbx_operator'),
            ])]"/>
        </record>

        <record id="demo_user_david" model="res.users">
            <field name="name">David NoPBX</field>
            <field name="login">pbx_demo_david</field>
            <field name="email">david.nopbx@example.com</field>
            <field name="password">pbx_demo_2026</field>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <record id="demo_user_erik" model="res.users">
            <field name="name">Erik Empty</field>
            <field name="login">pbx_demo_erik</field>
            <field name="email">erik.empty@example.com</field>
            <field name="password">pbx_demo_2026</field>
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_user'),
                ref('pbx_base.group_pbx_operator'),
            ])]"/>
        </record>

        <!-- Extensions. The implicit browser device is created by the model,
             so only the extra devices are listed here. -->
        <record id="demo_ext_adam" model="pbx.extension">
            <field name="public_number">9101</field>
            <field name="user_id" ref="demo_user_adam"/>
            <field name="callerid_name">Adam Admin</field>
        </record>

        <record id="demo_ext_berit" model="pbx.extension">
            <field name="public_number">9102</field>
            <field name="user_id" ref="demo_user_berit"/>
            <field name="callerid_name">Berit Office</field>
        </record>

        <record id="demo_ext_cecilia" model="pbx.extension">
            <field name="public_number">9103</field>
            <field name="user_id" ref="demo_user_cecilia"/>
            <field name="callerid_name">Cecilia Operator</field>
            <field name="ring_strategy">parallel</field>
        </record>

        <!-- Erik has an extension but no devices at all: the implicit
             browser device is removed so click-to-call hits the
             "no active device" path. -->
        <record id="demo_ext_erik" model="pbx.extension">
            <field name="public_number">9105</field>
            <field name="user_id" ref="demo_user_erik"/>
            <field name="callerid_name">Erik Empty</field>
        </record>

        <!-- Extra devices on Cecilia: two mobiles, so ring order and
             follow-me can be exercised. -->
        <record id="demo_device_cecilia_mobile_1" model="pbx.sub_extension">
            <field name="extension_id" ref="demo_ext_cecilia"/>
            <field name="type">mobile</field>
            <field name="label">Cecilia mobil 1</field>
            <field name="sequence">2</field>
            <field name="ring_timeout">20</field>
        </record>

        <record id="demo_device_cecilia_mobile_2" model="pbx.sub_extension">
            <field name="extension_id" ref="demo_ext_cecilia"/>
            <field name="type">mobile</field>
            <field name="label">Cecilia mobil 2</field>
            <field name="sequence">3</field>
            <field name="ring_timeout">20</field>
        </record>

        <!-- Berit: a hardware phone with a MAC, so provisioning has something
             to render. -->
        <record id="demo_device_berit_hardware" model="pbx.sub_extension">
            <field name="extension_id" ref="demo_ext_berit"/>
            <field name="type">hardware</field>
            <field name="label">Berit kontorstelefon</field>
            <field name="sequence">2</field>
            <field name="mac_address">00:15:65:AA:BB:CC</field>
        </record>

    </data>
</odoo>
