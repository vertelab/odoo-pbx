<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- is_pbx_tenant på standard-partnerformuläret (Misc-gruppen, i höjd med company) -->
    <record id="res_partner_pbx_tenant_flag" model="ir.ui.view">
        <field name="name">res.partner.pbx.tenant.flag</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='misc']" position="inside">
                <field name="is_pbx_tenant" string="PBX-tenant"/>
            </xpath>
        </field>
    </record>

    <!-- Tenants kanban (res.partner + is_pbx_tenant) -->
    <record id="pbx_tenant_kanban" model="ir.ui.view">
        <field name="name">res.partner.tenant.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="domain"/>
                <field name="server_id"/>
                <field name="minion_id"/>
                <field name="image_1920" widget="image"/>
                <field name="active"/>
                <t t-name="card">
                    <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill #{kanban_color}">
                        <div class="o_kanban_image">
                            <img t-if="image_1920" t-att-src="image_1920"
                                 class="o_image_64_cover" alt="Tenant"/>
                            <span t-else="" class="o_kanban_placeholder">
                                <i class="fa fa-building-o"/>
                            </span>
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="domain"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <span t-if="server_id" class="o_kanban_record_subtitle">
                                <i class="fa fa-server"/> <field name="server_id"/>
                            </span>
                            <span t-if="minion_id" class="o_kanban_record_subtitle ms-2">
                                <i class="fa fa-robot"/> <field name="minion_id"/>
                            </span>
                        </div>
                    </div>
                </t>
            </kanban>
        </field>
    </record>

    <!-- Tenant form: helt eget formulär — namn/bild + PBX-unika fält + länk till res.partner -->
    <record id="pbx_tenant_form" model="ir.ui.view">
        <field name="name">res.partner.tenant.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <form string="PBX Tenant">
                <header>
                    <button name="deploy_config" type="object" string="Minion-sync"
                            class="btn-primary" icon="fa-cloud-upload"
                            confirm="Deploya växelinfo till minionen? (salt state.apply odoo.pbx)"/>
                    <button name="action_open_partner" type="object" string="Öppna partner"
                            class="btn-secondary" icon="fa-external-link"/>
                </header>
                <sheet>
                    <field name="is_pbx_tenant" invisible="1"/>
                    <div class="oe_title">
                        <field name="image_1920" widget="image" class="oe_avatar" readonly="1"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group string="PBX">
                        <group>
                            <field name="domain"/>
                            <field name="server_id"/>
                            <field name="minion_id"/>
                        </group>
                        <group>
                            <field name="deploy_status"/>
                            <field name="last_deploy"/>
                        </group>
                    </group>
                    <group string="Deploy-logg">
                        <field name="deploy_log" readonly="1" nolabel="1"
                               placeholder="Minion-sync-logg…"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="pbx_tenant_notes">
                            <field name="comment" nolabel="1" placeholder="Anteckningar om tenanten…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Tenants (bara partners med is_pbx_tenant) -->
    <record id="pbx_tenant_act_window" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('is_pbx_tenant', '=', True)]</field>
        <field name="context">{'default_is_pbx_tenant': True}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'kanban', 'view_id': ref('pbx_tenant_kanban')}), (0, 0, {'view_mode': 'form', 'view_id': ref('pbx_tenant_form')})]"/>
    </record>
</odoo>
