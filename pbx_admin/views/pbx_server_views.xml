<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_server_form_view">
        <field name="model">pbx.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="reload_asterisk" type="object" string="Reload Asterisk"
                            class="btn-secondary" icon="fa-refresh"
                            confirm="Ladda om Asterisk (pjsip + dialplan + voicemail)?"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="host"/>
                        <field name="ami_port"/>
                        <field name="ami_user"/>
                        <field name="ami_secret" password="True"/>
                        <field name="config_path"/>
                        <field name="spool_path"/>
                        <field name="active"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pbx_server_list_view">
        <field name="model">pbx.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="host"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_server_act_window">
        <field name="name">PBX Servers</field>
        <field name="res_model">pbx.server</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
