<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_admin_settings_form_view">
        <field name="model">pbx.admin.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Asterisk">
                        <field name="server_id"/>
                    </group>
                    <group string="RabbitMQ / NATS">
                        <field name="rabbitmq_host"/>
                        <field name="rabbitmq_port"/>
                        <field name="rabbitmq_user"/>
                        <field name="rabbitmq_secret" password="True"/>
                    </group>
                    <group string="Billing API">
                        <field name="billing_api_enabled"/>
                        <field name="billing_api_token" password="True"  invisible="billing_api_enabled == False"/>
                    </group>
                    <group string="Zabbix">
                        <field name="zabbix_url"/>
                        <field name="zabbix_token" password="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
