<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MSP Settings action (central) -->
    <record id="pbx_admin_settings_action" model="ir.actions.act_window">
        <field name="name">PBX Settings</field>
        <field name="res_model">pbx.admin.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <menuitem
        id="menu_pbx_admin_settings"
        name="Settings"
        parent="pbx_base.menu_pbx_root"
        action="pbx_admin.pbx_admin_settings_action"
        sequence="100"
        groups="pbx_base.group_pbx_office"
    />

    <!-- Central administration: Asterisk servers + tenant/domain leases.
         pbx_admin installeras bara centralt (Ledningssystem). PBX Office
         (och därmed PBX Admin) administrerar servers/tenants här. -->
    <menuitem
        id="menu_pbx_servers"
        name="Servers"
        parent="pbx_base.menu_pbx_configuration"
        action="pbx_server_act_window"
        sequence="60"
        groups="pbx_base.group_pbx_office"
    />

    <menuitem
        id="menu_pbx_tenants"
        name="Tenants"
        parent="pbx_base.menu_pbx_configuration"
        action="pbx_tenant_act_window"
        sequence="70"
        groups="pbx_base.group_pbx_office"
    />
</odoo>
