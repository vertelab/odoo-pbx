<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_crm_settings_view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pbx_base.res_config_settings_view_form_pbx"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='pbx']//block[@title='Grundinställningar']" position="inside">
                <setting string="PBX CRM: Auto-popup lead on incoming call">
                    <field name="pbx_crm_auto_popup"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
