<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_helpdesk_settings_view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='integrations']" position="inside">
                <div class="row mt16">
                    <div class="col-12 col-lg-6 o_setting_container">
                        <div class="o_setting_left_pane">
                            <field name="pbx_helpdesk_auto_create_ticket"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pbx_helpdesk_auto_create_ticket" string="PBX Helpdesk: Auto-create ticket"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
