<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_recording_policy_form_view">
        <field name="model">pbx.recording.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="scope"/>
                        <field name="extension_id"  required="scope == 'extension'" invisible="scope != 'extension'"/>
                        <field name="mode"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pbx_recording_policy_list_view">
        <field name="model">pbx.recording.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="scope"/>
                <field name="mode"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_recording_policy_act_window">
        <field name="name">Recording Policies</field>
        <field name="res_model">pbx.recording.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pbx_recording"
        name="Recording"
        parent="pbx_base.menu_pbx_applications"
        action="pbx_recording_policy_act_window"
        sequence="70"
    />
</odoo>
