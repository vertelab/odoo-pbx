<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_recording_policy_form_view">
        <field name="model">pbx.recording.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="tenant_id"/>
                        <field name="scope"/>
                        <field name="queue_id" attrs="{'invisible': [('scope', '!=', 'queue')], 'required': [('scope', '=', 'queue')]}"/>
                        <field name="extension_id" attrs="{'invisible': [('scope', '!=', 'extension')], 'required': [('scope', '=', 'extension')]}"/>
                        <field name="mode"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pbx_recording_policy_list_view">
        <field name="model">pbx.recording.policy</field>
        <field name="arch" type="xml">
            <tree>
                <field name="tenant_id"/>
                <field name="scope"/>
                <field name="mode"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_recording_policy_act_window">
        <field name="name">Recording Policies</field>
        <field name="res_model">pbx.recording.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pbx_recording"
        name="Recording"
        parent="pbx_base.menu_pbx_root"
        action="pbx_recording_policy_act_window"
        sequence="70"
    />
</odoo>
