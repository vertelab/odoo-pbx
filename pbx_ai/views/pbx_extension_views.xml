<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- pbx.extension — transcribe_enabled (pbx-ai-call-assistant, D1) -->
    <record id="view_pbx_extension_form_ai" model="ir.ui.view">
        <field name="name">pbx.extension.form.ai</field>
        <field name="model">pbx.extension</field>
        <field name="inherit_id" ref="pbx_base.pbx_extension_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="ai" string="AI">
                    <field name="transcribe_enabled"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_pbx_extension_list_ai" model="ir.ui.view">
        <field name="name">pbx.extension.list.ai</field>
        <field name="model">pbx.extension</field>
        <field name="inherit_id" ref="pbx_base.pbx_extension_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="transcribe_enabled" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
