#. module: pbx_ai
#: model:ir.model.fields,help:pbx_ai.field_pbx_queue__recording_mode
msgid ""
"'' = inherit the global policy, 'record' = force recording, 'transcribe' = "
"recording + transcription. Inherited by extensions in the queue if they are "
"themselves empty."
msgstr "'' = ärv den globala policyn, 'record' = tvinga inspelning, 'transcribe' = inspelning + transkription. Ärvs av anknytningen."

#. module: pbx_ai
#: model:ir.model.fields,help:pbx_ai.field_pbx_extension__recording_mode
msgid ""
"'' = inherit the global policy/queue, 'record' = force recording, "
"'transcribe' = recording + transcription."
msgstr "'' = ärv den globala policyn/kön, 'record' = tvinga inspelning, 'transcribe' = inspelning + transkription."

