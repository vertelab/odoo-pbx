<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_queue_form_view">
        <field name="model">pbx.queue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="tenant_id"/>
                        <field name="name"/>
                        <field name="extension"/>
                        <field name="strategy"  readonly="is_ring_group == True"/>
                        <field name="timeout"  readonly="is_ring_group == True"/>
                        <field name="max_wait_time"  invisible="is_ring_group == True"/>
                        <field name="overflow_destination_id"  invisible="is_ring_group == True"/>
                        <field name="join_empty"  invisible="is_ring_group == True"/>
                        <field name="announce_position"/>
                        <field name="is_ring_group"/>
                        <field name="is_manual"/>
                        <field name="timeout_seconds"  invisible="is_ring_group == True"/>
                        <field name="timeout_action"  invisible="is_ring_group == True"/>
                        <field name="manual_target_queue_id"  invisible="is_ring_group == True"/>
                        <field name="active"/>
                    </group>
                    <group string="Agents">
                        <field name="member_ids" mode="list">
                            <list editable="bottom">
                                <field name="extension_id"/>
                                <field name="penalty"/>
                                <field name="paused"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pbx_queue_list_view">
        <field name="model">pbx.queue</field>
        <field name="arch" type="xml">
            <list>
                <field name="tenant_id"/>
                <field name="name"/>
                <field name="extension"/>
                <field name="strategy"/>
                <field name="is_ring_group"/>
                <field name="is_manual"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_queue_act_window">
        <field name="name">Queues</field>
        <field name="res_model">pbx.queue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pbx_queues"
        name="Queues"
        parent="pbx_base.menu_pbx_applications"
        action="pbx_queue_act_window"
        sequence="50"
    />
</odoo>
