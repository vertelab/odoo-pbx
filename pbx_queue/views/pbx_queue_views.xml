<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_queue_form_view">
        <field name="model">pbx.queue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Kö">
                            <field name="name"/>
                            <field name="extension"/>
                            <field name="strategy" readonly="is_ring_group == True"/>
                            <field name="timeout" readonly="is_ring_group == True"/>
                            <field name="join_empty" invisible="is_ring_group == True"/>
                            <field name="announce_position"/>
                            <field name="is_ring_group"/>
                            <field name="is_manual"/>
                            <field name="active"/>
                        </group>
                        <group string="Överflöde / Timeout" invisible="is_ring_group == True">
                            <field name="max_wait_time"/>
                            <field name="overflow_destination_id"/>
                            <field name="timeout_seconds"/>
                            <field name="timeout_action"/>
                            <field name="manual_target_queue_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agenter">
                            <field name="member_ids" mode="list">
                                <list editable="bottom">
                                    <field name="extension_id"/>
                                    <field name="penalty"/>
                                    <field name="paused"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pbx_queue_list_view">
        <field name="model">pbx.queue</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="name"/>
                <field name="extension"/>
                <field name="strategy"/>
                <field name="is_ring_group"/>
                <field name="is_manual"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_queue_act_window">
        <field name="name">Queues</field>
        <field name="res_model">pbx.queue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pbx_queues"
        name="Queues"
        parent="pbx_base.menu_pbx_applications"
        action="pbx_queue_act_window"
        sequence="50"
    />
</odoo>
