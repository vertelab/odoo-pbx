<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_queue_form_view">
        <field name="model">pbx.queue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="tenant_id"/>
                        <field name="name"/>
                        <field name="extension"/>
                        <field name="strategy" attrs="{'readonly': [('is_ring_group', '=', True)]}"/>
                        <field name="timeout" attrs="{'readonly': [('is_ring_group', '=', True)]}"/>
                        <field name="max_wait_time" attrs="{'invisible': [('is_ring_group', '=', True)]}"/>
                        <field name="overflow_destination" attrs="{'invisible': [('is_ring_group', '=', True)]}"/>
                        <field name="join_empty" attrs="{'invisible': [('is_ring_group', '=', True)]}"/>
                        <field name="announce_position"/>
                        <field name="is_ring_group"/>
                        <field name="active"/>
                    </group>
                    <group string="Agents">
                        <field name="member_ids" mode="tree">
                            <tree editable="bottom">
                                <field name="extension_id"/>
                                <field name="penalty"/>
                                <field name="paused"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pbx_queue_list_view">
        <field name="model">pbx.queue</field>
        <field name="arch" type="xml">
            <tree>
                <field name="tenant_id"/>
                <field name="name"/>
                <field name="extension"/>
                <field name="strategy"/>
                <field name="is_ring_group"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_queue_act_window">
        <field name="name">Queues</field>
        <field name="res_model">pbx.queue</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_pbx_queues"
        name="Queues"
        parent="pbx_base.menu_pbx_root"
        action="pbx_queue_act_window"
        sequence="50"
    />
</odoo>
