<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pbx_time_condition_form_view">
        <field name="model">pbx.time_condition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="name"/>
                        <div class="d-flex align-items-center">
                            <field name="extension"/>
                            <button name="action_next_free_extension" type="object"
                                    string="Nästa lediga" icon="fa-magic" class="btn-link ms-1"/>
                        </div>
                        <field name="timezone"/>
                    </group>
                    <group string="Schedule">
                        <field name="days_of_week"/>
                        <field name="start_time" widget="float_time"/>
                        <field name="end_time" widget="float_time"/>
                        <field name="holidays_calendar_id"/>
                    </group>
                    <group string="When time MATCHES — route to:">
                        <field name="destination_match_id"/>
                    </group>
                    <group string="When time does NOT match — route to:">
                        <field name="destination_nomatch_id"/>
                    </group>
                    <group>
                        <field name="active"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <chatter/>
                </div>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pbx_time_condition_list_view">
        <field name="model">pbx.time_condition</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="name"/>
                <field name="days_of_week"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pbx_time_condition_act_window">
        <field name="name">Time Conditions</field>
        <field name="res_model">pbx.time_condition</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pbx_time_conditions"
        name="Time Conditions"
        parent="pbx_base.menu_pbx_applications"
        action="pbx_time_condition_act_window"
        sequence="55"
    />

    <!-- Outbound route: Time Condition-fältet (finns bara när pluginen är installerad) -->
    <record model="ir.ui.view" id="outbound_route_form_time_condition">
        <field name="model">pbx.outbound_route</field>
        <field name="inherit_id" ref="pbx_base.pbx_outbound_route_form_view"/>
        <field name="arch" type="xml">
            <field name="time_source" position="after">
                <field name="time_condition_id"
                        invisible="time_source != 'time_condition'"/>
            </field>
        </field>
    </record>
</odoo>
